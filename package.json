{
  "name": "onda",
  "version": "1.0.0",
  "description": "Reproductor de música local",
  "main": "arranque.js",
  "author": "Luis Martínez",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "publicar": "electron-builder --win nsis --publish always",
    "postinstall": "node -e \"const f=require('fs');f.mkdirSync('vendor',{recursive:true});f.copyFileSync('node_modules/jsmediatags/dist/jsmediatags.min.js','vendor/jsmediatags.min.js')\""
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "asarUnpack": [
      "vendor/yt-dlp.exe",
      "vendor/ffmpeg.exe",
      "vendor/ffprobe.exe"
    ],
    "appId": "com.luismartinezprog.onda",
    "productName": "Onda",
    "files": [
      "arranque.js",
      "updater.js",
      "main.js",
      "preload.js",
      "index.html",
      "css/*",
      "js/*",
      "icon.png",
      "vendor/*",
      "!**/*.bak",
      "!**/*.bak-*"
    ],
    "publish": {
      "provider": "github",
      "owner": "LuisMartinezProg",
      "repo": "Onda",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "compression": "store"
  },
  "dependencies": {
    "@distube/ytdl-core": "^5.2.0",
    "electron-updater": "^6.3.0",
    "jsmediatags": "^3.9.7"
  }
}